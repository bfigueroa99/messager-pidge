# Copy to .env.local. Nothing here is a secret: everything prefixed
# EXPO_PUBLIC_ is inlined into the client bundle and is readable by anyone
# holding the app. Service-role keys never belong in this file.

# Which build variant to configure (development | preview | production).
APP_VARIANT=development

# The Supabase project the client talks to. Empty until Q-002 is answered.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# M1-09: EXPO_PUBLIC_TIME_SCALE only takes effect when EXPO_PUBLIC_E2E is
# exactly 'true' — leave both unset for a real build. Set together to watch
# a flight resolve in compressed real time (1440 turns a ~day into under a
# minute); see docs/DEMO_RECORDING.md.
EXPO_PUBLIC_E2E=
EXPO_PUBLIC_TIME_SCALE=
